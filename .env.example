# ==============================================================================
# STARKNET MCP (MODEL CONTEXT PROTOCOL) ENVIRONMENT CONFIGURATION
# ==============================================================================

# Required: At least one LLM API key
# ANTHROPIC_API_KEY="sk-ant-..."
# GEMINI_API_KEY="..."
# OPENAI_API_KEY="sk-..."

# Optional Model Override (Defaults automatically based on provider)
MODEL_NAME="gemini-1.5-pro"

# Starknet RPC Gateway (Default: Verified Public Cartridge Sepolia)
STARKNET_RPC_URL="https://api.cartridge.gg/x/starknet/sepolia"

# Optional Extended Tools
# EXTENDED_API_KEY=""
